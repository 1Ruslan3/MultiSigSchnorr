@page "/administration"
@rendermode InteractiveServer
@using MultiSigSchnorr.Contracts.Administration
@using MultiSigSchnorr.Domain.Enums
@inject MultiSigSchnorr.Web.Services.Api.ProtocolSessionsApiClient ApiClient

<PageTitle>Administration</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Administration</h1>
            <p class="admin-subtitle">
                Управление участниками, активной эпохой и составом группы подписантов.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success">@_info</div>
    }

    @if (_state is null)
    {
        <div class="admin-card">
            <em>Загрузка административного состояния...</em>
        </div>
    }
    else
    {
        <div class="admin-grid">
            <section class="admin-left">
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Активная эпоха</h3>
                    </div>

                    <div class="admin-meta-grid">
                        <div class="admin-meta-box">
                            <div class="admin-label">Epoch ID</div>
                            <code>@_state.ActiveEpochId</code>
                        </div>

                        <div class="admin-meta-box">
                            <div class="admin-label">Epoch Number</div>
                            <div>@_state.ActiveEpochNumber</div>
                        </div>

                        <div class="admin-meta-box">
                            <div class="admin-label">Status</div>
                            <span class="status-pill status-@GetEpochStatusCss(_state.ActiveEpochStatus)">
                                @_state.ActiveEpochStatus
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        Чтобы изменить состав группы, выбери участников и создай новую эпоху.
                        Уже созданные протокольные сессии не изменяются.
                    </div>

                    <div class="action-row mt-3">
                        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_isBusy">
                            Обновить
                        </button>

                        <button class="btn btn-primary"
                                @onclick="CreateEpochWithSelectedMembersAsync"
                                disabled="@(_isBusy || _selectedParticipantIds.Count < 2)">
                            Создать новую эпоху с выбранным составом
                        </button>
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Создание участника</h3>
                    </div>

                    <div class="form-block">
                        <label for="new-participant-display-name">Имя участника</label>
                        <input id="new-participant-display-name"
                               class="form-control"
                               placeholder="Например: Alice, Bob, Signer-4"
                               @bind="_newParticipantDisplayName"
                               @bind:event="oninput"
                               disabled="@_isBusy" />
                    </div>

                    <div class="action-row mt-3">
                        <button class="btn btn-primary"
                                @onclick="CreateParticipantAsync"
                                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_newParticipantDisplayName))">
                            Создать участника
                        </button>
                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        Новый участник получает приватный ключ только в runtime-памяти API.
                        После перезапуска API публичная запись останется в PostgreSQL, но private key material исчезнет.
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Параметры отзыва</h3>
                    </div>

                    <div class="form-block">
                        <label for="revoke-reason">Причина отзыва</label>
                        <textarea id="revoke-reason"
                                  class="form-control admin-textarea"
                                  @bind="_revokeReason"
                                  disabled="@_isBusy"></textarea>
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Выбор состава новой эпохи</h3>
                    </div>

                    <div class="action-column">
                        <button class="btn btn-outline-secondary" @onclick="SelectOnlyActiveMembers" disabled="@_isBusy">
                            Выбрать текущий состав
                        </button>

                        <button class="btn btn-outline-secondary" @onclick="SelectAllActiveParticipants" disabled="@_isBusy">
                            Выбрать всех Active
                        </button>

                        <button class="btn btn-outline-secondary" @onclick="ClearSelectedParticipants" disabled="@_isBusy">
                            Очистить выбор
                        </button>
                    </div>

                    <div class="alert alert-secondary mt-3 mb-0">
                        Выбрано участников: <strong>@_selectedParticipantIds.Count</strong>.
                        Для новой эпохи нужно минимум 2 участника.
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>История эпох</h3>
                    </div>

                    <div class="epoch-history-list">
                        @foreach (var epoch in _state.Epochs.OrderByDescending(x => x.EpochNumber))
                        {
                            <div class="epoch-history-item">
                                <div class="epoch-history-main">
                                    <div><strong>Epoch № @epoch.EpochNumber</strong></div>
                                    <div class="epoch-history-id">@epoch.EpochId</div>
                                </div>
                                <span class="status-pill status-@GetEpochStatusCss(epoch.EpochStatus)">
                                    @epoch.EpochStatus
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="admin-right">
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Участники</h3>
                    </div>

                    <div class="participants-list">
                        @foreach (var participant in _state.Participants.OrderBy(x => x.DisplayName))
                        {
                            <div class="participant-card">
                                <div class="participant-header">
                                    <div>
                                        <div class="participant-name">@participant.DisplayName</div>
                                        <div class="participant-id">@participant.ParticipantId</div>
                                    </div>

                                    <div class="participant-statuses">
                                        <span class="status-pill status-@GetParticipantStatusCss(participant.ParticipantStatus)">
                                            @participant.ParticipantStatus
                                        </span>

                                        @if (participant.IsActiveMemberOfActiveEpoch)
                                        {
                                            <span class="member-pill member-active">Active member</span>
                                        }
                                        else if (participant.IsMemberOfActiveEpoch)
                                        {
                                            <span class="member-pill member-inactive">Inactive member</span>
                                        }
                                        else
                                        {
                                            <span class="member-pill member-none">Not in active epoch</span>
                                        }

                                        @if (participant.HasRuntimePrivateKeyMaterial)
                                        {
                                            <span class="member-pill member-active">Runtime key ready</span>
                                        }
                                        else
                                        {
                                            <span class="member-pill member-inactive">Missing runtime key</span>
                                        }
                                    </div>
                                </div>

                                <div class="participant-fields">
                                    <div>
                                        <div class="admin-label">Public Key</div>
                                        <code>@participant.PublicKeyHex</code>
                                    </div>
                                </div>

                                <div class="form-block mt-3">
                                    <label>Новое имя</label>
                                    <input class="form-control"
                                           value="@GetRenameValue(participant.ParticipantId, participant.DisplayName)"
                                           @oninput="args => SetRenameValue(participant.ParticipantId, args.Value?.ToString() ?? string.Empty)"
                                           disabled="@_isBusy" />
                                </div>

                                <div class="action-row mt-3">
                                    <label class="member-select-row">
                                        <input type="checkbox"
                                               checked="@_selectedParticipantIds.Contains(participant.ParticipantId)"
                                               disabled="@(_isBusy || participant.ParticipantStatus != ParticipantStatus.Active || !participant.HasRuntimePrivateKeyMaterial)"
                                               @onchange="args => ToggleParticipantSelection(participant.ParticipantId, args)" />
                                        <span>Включить в новую эпоху</span>
                                    </label>
                                </div>

                                <div class="action-row mt-3">
                                    <button class="btn btn-outline-primary"
                                            disabled="@_isBusy"
                                            @onclick="() => RenameParticipantAsync(participant.ParticipantId)">
                                        Переименовать
                                    </button>

                                    <button class="btn btn-outline-danger"
                                            disabled="@(_isBusy || !participant.CanBeRevoked)"
                                            @onclick="() => RevokeParticipantAsync(participant.ParticipantId)">
                                        Отозвать участника
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code
{
    private EpochAdministrationStateApiResponse? _state;
    private readonly HashSet<Guid> _selectedParticipantIds = new();
    private readonly Dictionary<Guid, string> _renameInputs = new();

    private string? _error;
    private string? _info;
    private string _newParticipantDisplayName = string.Empty;
    private string _revokeReason = "Administrative revocation";
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _isBusy = true;
            _error = null;
            _info = null;

            _state = await ApiClient.GetAdministrationStateAsync();

            SyncRenameInputs();

            if (_selectedParticipantIds.Count == 0)
                SelectOnlyActiveMembers();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateParticipantAsync()
    {
        try
        {
            _isBusy = true;
            _error = null;
            _info = null;

            var displayName = _newParticipantDisplayName.Trim();

            if (string.IsNullOrWhiteSpace(displayName))
                throw new InvalidOperationException("Display name cannot be empty.");

            _state = await ApiClient.CreateParticipantAsync(displayName);
            _newParticipantDisplayName = string.Empty;
            _info = $"Участник '{displayName}' создан.";

            SyncRenameInputs();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RenameParticipantAsync(Guid participantId)
    {
        try
        {
            _isBusy = true;
            _error = null;
            _info = null;

            var displayName = GetRenameValue(participantId, string.Empty).Trim();

            if (string.IsNullOrWhiteSpace(displayName))
                throw new InvalidOperationException("Display name cannot be empty.");

            _state = await ApiClient.RenameParticipantAsync(participantId, displayName);
            _info = "Участник переименован.";

            SyncRenameInputs();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RevokeParticipantAsync(Guid participantId)
    {
        try
        {
            _isBusy = true;
            _error = null;
            _info = null;

            _state = await ApiClient.RevokeParticipantAsync(participantId, _revokeReason);
            _selectedParticipantIds.Remove(participantId);
            _info = $"Участник '{participantId}' был отозван.";

            SyncRenameInputs();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateEpochWithSelectedMembersAsync()
    {
        try
        {
            _isBusy = true;
            _error = null;
            _info = null;

            if (_selectedParticipantIds.Count < 2)
                throw new InvalidOperationException("At least two participants are required for a new epoch.");

            _state = await ApiClient.CreateEpochWithMembersAsync(_selectedParticipantIds.ToList());
            _info = "Новая эпоха с выбранным составом создана.";

            _selectedParticipantIds.Clear();
            SyncRenameInputs();
            SelectOnlyActiveMembers();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleParticipantSelection(Guid participantId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;

        if (isChecked)
            _selectedParticipantIds.Add(participantId);
        else
            _selectedParticipantIds.Remove(participantId);
    }

    private void SelectOnlyActiveMembers()
    {
        _selectedParticipantIds.Clear();

        if (_state is null)
            return;

        foreach (var participant in _state.Participants
                     .Where(x => x.IsActiveMemberOfActiveEpoch &&
                                 x.ParticipantStatus == ParticipantStatus.Active))
        {
            _selectedParticipantIds.Add(participant.ParticipantId);
        }
    }

    private void SelectAllActiveParticipants()
    {
        _selectedParticipantIds.Clear();

        if (_state is null)
            return;

        foreach (var participant in _state.Participants
                     .Where(x => x.ParticipantStatus == ParticipantStatus.Active))
        {
            _selectedParticipantIds.Add(participant.ParticipantId);
        }
    }

    private void ClearSelectedParticipants()
    {
        _selectedParticipantIds.Clear();
    }

    private void SyncRenameInputs()
    {
        if (_state is null)
            return;

        foreach (var participant in _state.Participants)
            _renameInputs[participant.ParticipantId] = participant.DisplayName;
    }

    private string GetRenameValue(Guid participantId, string fallback)
    {
        return _renameInputs.TryGetValue(participantId, out var value)
            ? value
            : fallback;
    }

    private void SetRenameValue(Guid participantId, string value)
    {
        _renameInputs[participantId] = value;
    }

    private static string GetEpochStatusCss(EpochStatus status) => status switch
    {
        EpochStatus.Draft => "default",
        EpochStatus.Active => "completed",
        EpochStatus.Closed => "reveal",
        EpochStatus.Archived => "failed",
        _ => "default"
    };

    private static string GetParticipantStatusCss(ParticipantStatus status) => status switch
    {
        ParticipantStatus.Pending => "default",
        ParticipantStatus.Active => "completed",
        ParticipantStatus.Revoked => "failed",
        ParticipantStatus.Suspended => "reveal",
        _ => "default"
    };
}
