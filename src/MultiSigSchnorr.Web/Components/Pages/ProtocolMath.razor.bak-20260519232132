@page "/protocol-math"
@page "/protocol-math/{SessionId:guid}"
@using MultiSigSchnorr.Contracts.ProtocolMath
@using System.Net.Http.Json
@using System.Reflection
@rendermode InteractiveServer
@inject MultiSigSchnorr.Web.Services.Api.ProtocolSessionsApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Protocol Math</PageTitle>

<div class="math-page">
    <section class="math-hero">
        <div>
            <div class="math-eyebrow">Mathematical protocol trace</div>
            <h1>Математический разбор подписи</h1>
            <p>
                Подробная демонстрация публичных вычислений: commitments, challenge,
                partial signature checks и финальная проверка <code>s · G = R + c · X</code>.
            </p>
        </div>

        <div class="math-hero-card">
            <strong>Проверки выполняет backend</strong>
            <span>
                Страница получает результаты из <code>GET /api/protocol-sessions/{sessionId}/math-trace</code>.
                Secret nonce и private key не выводятся.
            </span>
        </div>
    </section>

    <section class="session-loader">
        <label class="form-label">Session ID</label>
        <div class="loader-row">
            <input class="form-control"
                   placeholder="Введите Session ID"
                   @bind="_sessionIdText"
                   @bind:event="oninput" />

            <button class="btn btn-primary"
                    @onclick="LoadAsync"
                    disabled="@_isBusy">
                Загрузить разбор
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_isBusy)
    {
        <div class="math-card">
            <em>Загрузка backend math trace...</em>
        </div>
    }
    else if (_trace is not null)
    {
        <section class="math-card">
            <div class="card-title-row">
                <div>
                    <h2>Session Summary</h2>
                    <p>Общие данные сессии и публичные криптографические значения.</p>
                </div>

                <a class="btn btn-outline-secondary" href="protocol-sessions">
                    Вернуться к протоколу
                </a>
            </div>

            <div class="summary-grid">
                <div>
                    <span>Session ID</span>
                    <code>@_trace.SessionId</code>
                </div>
                <div>
                    <span>Epoch ID</span>
                    <code>@_trace.EpochId</code>
                </div>
                <div>
                    <span>Epoch Number</span>
                    <strong>@_trace.EpochNumber</strong>
                </div>
                <div>
                    <span>Status</span>
                    <strong>@_trace.SessionStatus</strong>
                </div>
                <div>
                    <span>Protection Mode</span>
                    <strong>@_trace.ProtectionMode</strong>
                </div>
                <div>
                    <span>Participants</span>
                    <strong>@_trace.Participants.Count</strong>
                </div>
            </div>
        </section>

        <section class="math-card">
            <div class="card-title-row">
                <div>
                    <h2>Пошаговый trace</h2>
                    <p>Формулы, публичные значения и результаты backend-проверок.</p>
                </div>
            </div>

            <div class="steps-list">
                @foreach (var step in _trace.Steps)
                {
                    <article class="math-step @(step.IsComplete ? "complete" : "pending")">
                        <div class="step-head">
                            <div class="step-number">@step.Number.ToString("00")</div>
                            <div>
                                <h3>@step.Title</h3>
                                <span>@step.Stage</span>
                            </div>
                            <div class="step-status">
                                @(step.IsComplete ? "done" : "pending")
                            </div>
                        </div>

                        <p>@step.Description</p>

                        <div class="formula-box">
                            @step.Formula
                        </div>

                        @if (step.Values.Count > 0)
                        {
                            <div class="value-grid">
                                @foreach (var item in step.Values)
                                {
                                    <div class="value-item">
                                        <span>@item.Key</span>
                                        <code>@Shorten(item.Value)</code>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="math-card">
            <div class="card-title-row">
                <div>
                    <h2>Проверки участников</h2>
                    <p>
                        Backend пересчитывает commitment и публичное равенство частичной подписи.
                    </p>
                </div>
            </div>

            <div class="participant-math-grid">
                @foreach (var participant in _trace.Participants)
                {
                    <article class="participant-math-card">
                        <div class="participant-head">
                            <strong>@participant.DisplayName</strong>
                            <code>@participant.ParticipantId</code>
                        </div>

                        <div class="participant-values">
                            <div>
                                <span>Cᵢ stored</span>
                                <code>@Shorten(participant.CommitmentHex)</code>
                            </div>
                            <div>
                                <span>H(Rᵢ) recomputed</span>
                                <code>@Shorten(participant.CommitmentRecomputedHex)</code>
                            </div>
                            <div>
                                <span>Commitment check</span>
                                <code>@FormatBool(participant.CommitmentMatchesPublicNonce)</code>
                            </div>
                            <div>
                                <span>sᵢ · G</span>
                                <code>@Shorten(participant.PartialSignatureLeftPointHex)</code>
                            </div>
                            <div>
                                <span>Rᵢ + c · aᵢ · Pᵢ</span>
                                <code>@Shorten(participant.PartialSignatureRightPointHex)</code>
                            </div>
                            <div>
                                <span>Partial equation</span>
                                <code>@FormatBool(participant.PartialSignatureEquationHolds)</code>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="math-card final-check">
            <div class="card-title-row">
                <div>
                    <h2>Финальная проверка</h2>
                    <p>
                        Итоговое равенство агрегированной подписи:
                        <code>s · G ?= R + c · X</code>.
                    </p>
                </div>
            </div>

            <div class="equation-panel">
                <div class="equation-line">
                    <span>left</span>
                    <code>@Shorten(_trace.FinalVerification.LeftPointHex)</code>
                </div>
                <div class="equation-line">
                    <span>right</span>
                    <code>@Shorten(_trace.FinalVerification.RightPointHex)</code>
                </div>
                <div class="equation-line result">
                    <span>result</span>
                    <code>@FormatBool(_trace.FinalVerification.EquationHolds)</code>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="math-card empty-state">
            <h2>Выберите протокольную сессию</h2>
            <p>
                Для математического разбора нужна созданная сессия. После выполнения этапов протокола
                backend сможет показать публичные проверки.
            </p>
        </div>
    }
</div>

@code
{
    [Parameter]
    public Guid? SessionId { get; set; }

    private string _sessionIdText = string.Empty;
    private string? _error;
    private bool _isBusy;
    private ProtocolMathTraceApiResponse? _trace;

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId.HasValue && SessionId.Value != Guid.Empty)
        {
            _sessionIdText = SessionId.Value.ToString();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _trace = null;

            if (!Guid.TryParse(_sessionIdText, out var sessionId))
            {
                _error = "Введите корректный Session ID.";
                return;
            }

            _isBusy = true;

            var httpClient = GetHttpClientFromApiClient();
            _trace = await httpClient.GetFromJsonAsync<ProtocolMathTraceApiResponse>(
                $"api/protocol-sessions/{sessionId}/math-trace");

            if (_trace is null)
            {
                _error = "Backend не вернул math trace.";
                return;
            }

            if (SessionId != sessionId)
            {
                Navigation.NavigateTo($"/protocol-math/{sessionId}", replace: true);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private HttpClient GetHttpClientFromApiClient()
    {
        var field = ApiClient.GetType()
            .GetField("_httpClient", BindingFlags.NonPublic | BindingFlags.Instance);

        if (field?.GetValue(ApiClient) is HttpClient httpClient)
            return httpClient;

        throw new InvalidOperationException(
            "ProtocolSessionsApiClient internal HttpClient was not found.");
    }

    private static string FormatBool(bool? value)
    {
        return value switch
        {
            true => "true",
            false => "false",
            _ => "not available"
        };
    }

    private static string Shorten(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";

        if (value.Length <= 56)
            return value;

        return $"{value[..30]}...{value[^20..]}";
    }
}
